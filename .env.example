POSTGRES_DB=rainbow
POSTGRES_USER=rainbow
POSTGRES_PASSWORD=change-me
DB_PORT=5432
APP_PORT=8080
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-me
AI_MODEL=deepseek-chat
AI_MAX_COMPLETION_TOKENS=4096

# Local approval sandbox. Keep disabled on public hosts unless access control is added.
SANDBOX_ENABLED=true
SANDBOX_IMAGE=maven:3.9-eclipse-temurin-17
# Optional: populated Maven artifact cache mounted read-only into the sandbox.
SANDBOX_MAVEN_REPOSITORY=
SANDBOX_TIMEOUT=3m
SANDBOX_MEMORY=768m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
AI_STREAM_MODE=native
AI_WORKSPACE_ROOT=..
AI_CONTEXT_MAX_FILES=20
AI_CONTEXT_MAX_FILE_CHARS=3500
AI_CONTEXT_MAX_TOTAL_CHARS=16000
MCP_ENABLED=false
